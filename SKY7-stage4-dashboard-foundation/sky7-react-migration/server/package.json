{
  "name": "sky7-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "check": "node --check src/server.js && node --check src/app.js && node --check prisma/seed.js && node --check prisma/create-owner.js && node --test",
    "db:create-owner": "node prisma/create-owner.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "zod": "3.25.76",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
